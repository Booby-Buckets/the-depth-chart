# Reddit app credentials for the Buzz fetcher (build_player_buzz.py).
# 1. Register a free app at https://www.reddit.com/prefs/apps  (type: "script")
# 2. Copy this file to  scripts/.env.buzz  and paste your values below.
#    scripts/.env.buzz is gitignored — it never gets committed.
# 3. Run:  ./scripts/run_buzz_local.sh          (top 50 players, quick quality check)
#          ./scripts/run_buzz_local.sh 80 500   (min_grade limit — full run)

REDDIT_CLIENT_ID=paste_the_string_under_your_app_name
REDDIT_CLIENT_SECRET=paste_the_secret_field
REDDIT_UA=the-depth-chart-cbb/0.1 by u/your_reddit_username
