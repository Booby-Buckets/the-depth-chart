{
  "functions": {
    "api/arb-scan.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/scripts/data/(.*\\.json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/bet/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/bet-sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "bet.thedepthchartcbb.com"
        }
      ],
      "destination": "/tonight",
      "permanent": false
    },
    {
      "source": "/:page.html",
      "has": [
        {
          "type": "host",
          "value": "bet.thedepthchartcbb.com"
        }
      ],
      "destination": "https://www.thedepthchartcbb.com/:page.html",
      "permanent": false
    },
    {
      "source": "/recent-additions.html",
      "destination": "/just-added.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/tonight",
      "has": [
        {
          "type": "host",
          "value": "bet.thedepthchartcbb.com"
        }
      ],
      "destination": "/bet/index.html"
    },
    {
      "source": "/:page(games|game|props|pickem|arb|futures|markets|trends|record|tools|learn)",
      "has": [
        {
          "type": "host",
          "value": "bet.thedepthchartcbb.com"
        }
      ],
      "destination": "/bet/:page.html"
    }
  ]
}
